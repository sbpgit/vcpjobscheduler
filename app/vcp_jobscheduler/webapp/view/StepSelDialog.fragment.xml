<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog  contentWidth="400px" showHeader="false">
        <content>
        <VBox >
        <Title text="" />
            <Title class="sapUiSmallMarginBegin" text="Please Provide Variant name to save the variant" />
            <Input id="idVarName" value="" width="200px" liveChange="onvariantNameChange" class="sapUiSmallMarginBegin" />
            </VBox>
 
        </content>
        <buttons>
        <Button type='Accept' text="{i18n>Confirm}" press="onConfirmVariant"></Button>
                <Button type='Reject' text="{i18n>close}" press="oncloseVariant"></Button>
        </buttons>
       
    </Dialog>
    
</core:FragmentDefinition>