<mvc:View controllerName="vcpapp.vcptemplate.controller.Variant"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:l="sap.ui.layout"
    xmlns:dnd="sap.ui.core.dnd"
    xmlns:f="sap.ui.layout.form">
        <Page id="newvariantPage" showHeader="true"  >
            
            <headerContent>
					<Button icon="sap-icon://nav-back" press="onBack"/>
				<ToolbarSpacer/>
					<Title text="Variant Maintenance" class="boldText" />
				<ToolbarSpacer/>
					<Button id="idClear" type="Transparent" text="Clear Data"  press="OnClear"  tooltip="Clear Variant Data" />
					
	</headerContent>
            <content> 
			
    <SplitApp
		id="SplitAppDemo"
		initialDetail="detail"
		initialMaster="master" >
        <masterPages>
		 <Page id="newvatPage" showHeader="true"  >

					<headerContent>
					<ToolbarSpacer/>
						<SearchField id="idListSearch" liveChange="onListSearch" placeholder="Search"  width="60%"  />
						<ToolbarSpacer/>
						<Button id="idCreate" text="Create" press="OnClear" type="Emphasized" ></Button>
						<Button id="idJobs" text="Show Jobs List" press="onJobPress" type="Transparent" visible="false"></Button>
						<Button id="idVars" text="Show Variants" press="onJobPress" type="Transparent"></Button>
						
					</headerContent>
        <Table id="idVarList" mode="SingleSelectMaster" rememberSelections="false" selectionChange="onVariantSel"
				items="{path: '/results'}" visible="true">
					<!-- <headerToolbar>
			<OverflowToolbar>
						<SearchField id="idListSearch" liveChange="onListSearch" placeholder="Search" width="350px"  />
						<ToolbarSpacer/>
						<Button id="idCreate" text="Create" press="OnClear" type="Emphasized" ></Button>
						<Button id="idJobs" text="Show Jobs List" press="onJobPress" type="Transparent" visible="false"></Button>
						<Button id="idVars" text="Show Variants" press="onJobPress" type="Transparent"></Button>
				</OverflowToolbar>
		</headerToolbar> -->
				<columns>
                <Column hAlign="Begin" vAlign="Middle" >
						<Text text="Variant"/>
					</Column>
					<Column hAlign="Begin" vAlign="Middle" >
						<Text text=""/>
					</Column>
					
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{VARIANT_NAME}" text="{VARIANT_DESC}"/>
							<HBox >
                            <Button id="idEditV" type="Transparent" icon="sap-icon://edit" tooltip="Edit" press="onChangeVariant"></Button>
                            <Button id="idCopyV" type="Transparent" icon="sap-icon://copy" tooltip="Copy" press="onChangeVariant"></Button>
                            <Button id="idDelV" type="Transparent" icon="sap-icon://delete" tooltip="Delete" press="onChangeVariant"></Button>
                            </HBox>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
<Table id="idJobList" mode="SingleSelectMaster" rememberSelections="false" selectionChange="onJobSel"
				items="{path: '/results'}" visible="false" >
				
				<columns>
                <Column hAlign="Begin" vAlign="Middle" >
						<Text text="Job Name"/>
					</Column>
					
					
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<ObjectIdentifier title="{ACTIVITY_ID}"  text="{ACTIVITY_DESC}"/>
							
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			</Page>
        </masterPages>
		<detailPages>

<Page id="idPagevariant" showHeader="false" class="boldText" showFooter="true" >
<content>
 	<f:Form id="idVariantForms" width="2000px">
                
                <f:layout>
				<f:ResponsiveGridLayout
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="12"
					labelSpanS="12"
					adjustLabelSpan="false"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="2"
					columnsL="2"
					columnsM="1"
					singleContainerFullSize="false" />
			</f:layout>
			<f:formContainers>
				<f:FormContainer >
					<f:formElements>						
						<f:FormElement>
							<f:fields>
                            <HBox class="left">
                            <Label text="Job Variant : " required="true" class="sapUiTinyMarginTop wid"/>
                            <Input id="idVariant" value="" width="300px" liveChange="onVarNameChange" class="sapUiTinyMarginBegin"/>
                            </HBox>
								
							</f:fields>
						</f:FormElement>
                        <f:FormElement>
							<f:fields>
                            <HBox >
                            <Label text="Job Variant Desc : " required="true" class="sapUiTinyMarginTop wid"/>
                            <Input id="idVarDesc" value="" width="500px" class="sapUiTinyMarginBegin"/>
                            </HBox>
								
							</f:fields>
						</f:FormElement>
					</f:formElements>
				</f:FormContainer>
			</f:formContainers>
		</f:Form>
           

         <!-- <HBox > -->
            <VBox width="100%" class="vboxline">
