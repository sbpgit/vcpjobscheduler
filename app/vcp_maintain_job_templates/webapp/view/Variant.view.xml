        </content>
	
    </Page>
	

        </detailPages>
		
	</SplitApp>
    </content>
	<footer>
            <Toolbar >
                <ToolbarSpacer/>
                <Button id="idSave" type="Transparent" text="{i18n>save}" press="onSaveVariant"></Button>
                <Button id="idCancel" type="Transparent" text="{i18n>cancel}" press="onCancel"></Button>
            </Toolbar>
        </footer>
     </Page>
    </mvc:View>



