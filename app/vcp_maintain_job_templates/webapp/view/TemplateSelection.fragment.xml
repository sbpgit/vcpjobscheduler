<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="idDJobtempSel"  showHeader="false" contentWidth="800px" contentHeight="550px">
		<content id="idContentsel1">
			<!-- <Table id="idTabTempSel" mode="MultiSelect" selectionChange="onJobTemSel" rememberSelections="false"
				items="{path: '/results'}" sticky="ColumnHeaders"> -->
				<!-- <SearchField id="idTempSel" liveChange="onTemplateSearch" width="300px" placeholder="{i18n>template}"/> -->
				<Table id="idTabTempSel" mode="MultiSelect"  rememberSelections="true"
				items="{path: '/results'}" sticky="ColumnHeaders">
				<headerToolbar>
					<Toolbar>
						<SearchField id="idTempSel" liveChange="onTemplateSearch" width="300px" placeholder="{i18n>template}"/>
						<ToolbarSpacer/>
						<HBox id="LayerGroup1" visible="false">
                                                <Label text="Group" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
                                            <Select id="idLayer1" change="onLayerCode1" selectedKey="I">
                                                <core:ListItem key="I" text="Internal"/>
                                                <core:ListItem key="E" text="External"/>
                                                
                                            </Select>
											</HBox>
					</Toolbar>
				</headerToolbar>
				<columns>
				<Column hAlign="Begin" vAlign="Middle">
						<Text text="{i18n>jobtemplate}"/>
					</Column>
					<Column hAlign="Begin" vAlign="Middle">
						<Text text="{i18n>steps}"/>
					</Column>
					
					
				</columns>
				<items>
					<ColumnListItem>
						<cells>
							<Text text="{TEMPLATE_ID}"></Text>
							<Text text="{STEPS}"></Text>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
		<buttons>
				<Button type='Accept' text="Select" press="onJobTemSel"></Button>
				<Button type='Reject' text="Cancel" press="onSelCancel"></Button>
		</buttons>
	</Dialog>
</core:FragmentDefinition>